# ---- Platform (one process, one port, one database) ----
PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/blinkit
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEFAULT_STORE_ID=6ad8eebdfce460c6fde26605

# ---- Auth (shared by all modules) ----
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Customer module ----
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
DEV_FIXED_OTP=123456
ADMIN_BOOTSTRAP_EMAIL=admin@blinkit.com
ADMIN_BOOTSTRAP_PASSWORD=change_me

# ---- Store (admin panel) module ----
ENABLE_DEMO_TOOLS=true
STORE_OWNER_EMAIL=owner@blinkit.com
STORE_OWNER_PASSWORD=change_me

# ---- Delivery module ----
DELIVERY_TOKEN_EXPIRES_IN=7d
SEED_DEMO_RIDERS=true
DEMO_RIDER_PASSWORD=Rider@123

# ---- Optional: ports when running a module on its own (npm run dev:<module>) ----
# CUSTOMER_PORT=3000
# STORE_PORT=5001
# DELIVERY_PORT=5002
