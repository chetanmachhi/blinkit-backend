{
  "name": "blinkit-backend",
  "version": "1.0.0",
  "description": "Blinkit backend (modular monolith): customer, store-admin and delivery modules in one deployable service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "dev:customer": "ts-node-dev --respawn --transpile-only src/modules/customer/server.ts",
    "dev:store": "ts-node-dev --respawn --transpile-only src/modules/store/server.ts",
    "dev:delivery": "ts-node-dev --respawn --transpile-only src/modules/delivery/server.ts",
    "seed": "ts-node-dev --transpile-only src/modules/customer/scripts/seed.ts",
    "seed:store": "ts-node-dev --transpile-only src/modules/store/scripts/seedStore.ts",
    "seed:demo": "ts-node-dev --transpile-only src/modules/store/scripts/seedDemo.ts",
    "seed:riders": "ts-node-dev --transpile-only src/modules/delivery/scripts/seedRiders.ts",
    "seed:prod": "node dist/modules/customer/scripts/seed.js",
    "seed:store:prod": "node dist/modules/store/scripts/seedStore.js",
    "seed:demo:prod": "node dist/modules/store/scripts/seedDemo.js",
    "seed:riders:prod": "node dist/modules/delivery/scripts/seedRiders.js"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.0",
    "@types/node": "^20.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
